# .env.example — PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como .env y llena los valores reales
# NUNCA commitees el archivo .env con valores reales

# Supabase (API / backend serverless y Express)
# Proyecto: https://gxgcedivktkubhnmedsp.supabase.co  (ref: gxgcedivktkubhnmedsp)
SUPABASE_URL=https://gxgcedivktkubhnmedsp.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui
# Para CLI: npx supabase login && npx supabase link --project-ref gxgcedivktkubhnmedsp
# Migraciones remotas (npm run db:push:remote): URI completa o solo contraseña de Postgres:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.gxgcedivktkubhnmedsp.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=PASSWORD_DE_POSTGRES
# Alias documentado (mismo valor que SERVICE_KEY si tu tooling lo espera)
# SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=tu-bot-token-aqui
TELEGRAM_CHAT_ID=-tu-chat-id-aqui
# Fases siguientes (grupo cocina / gerencia)
# TELEGRAM_ORDERS_CHAT_ID=
# TELEGRAM_ALERTS_CHAT_ID=

# App
APP_TIMEZONE=America/Mexico_City
APP_CURRENCY=MXN
APP_TAX_RATE=0.16

# Forecasting (fases posteriores)
FORECAST_BUFFER_DAYS=2
FORECAST_HISTORY_DAYS=56

# Frontend (Vite — necesitan prefijo VITE_)
VITE_SUPABASE_URL=https://gxgcedivktkubhnmedsp.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Email del único login OPS (no se muestra en la UI; mismo usuario en Supabase Auth)
VITE_OPS_AUTH_EMAIL=ops@tudominio.com
# Solo para script local scripts/fix-auth.mjs (nunca prefijo VITE_; no subir a git)
# OPS_STAFF_PASSWORD=define-una-clave-segura-min-8-chars
# En producción (Vercel) deja vacío para usar rutas relativas /api/*
# En dev con Express local para CMS:
# VITE_API_URL=http://localhost:3001

# Vercel / serverless (api/*): mismas que SUPABASE en raíz para órdenes, reportes e inventario
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=   # service_role — no subir a git
# TELEGRAM_ORDERS_CHAT_ID=
# APP_TIMEZONE=America/Mexico_City

# Storage (bucket del CMS de imágenes)
# SUPABASE_STORAGE_BUCKET_MENU=menu-images
